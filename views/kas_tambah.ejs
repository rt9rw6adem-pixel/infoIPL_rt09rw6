<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Input Transaksi Kas RT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="mb-3"><a href="/kas" class="text-decoration-none text-secondary fw-semibold">← Kembali ke Laporan Kas</a></div>
        <div class="card shadow border-0">
            <div class="card-header py-3 <%= jenis === 'pemasukan' ? 'bg-success text-white' : 'bg-danger text-white' %>">
                <h5 class="mb-0 fw-bold"><%= jenis === 'pemasukan' ? '🟢 REKORD DATA PEMASUKAN KAS' : '🔴 REKORD DATA PENGELUARAN KAS' %></h5>
            </div>
            <div class="card-body p-4">
                <form action="/kas/simpan" method="POST">
                    <input type="hidden" name="jenis" value="<%= jenis %>">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tanggal Transaksi</label>
                        <input type="date" name="tanggal" class="form-control form-control-lg border-secondary" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold <%= jenis === 'pemasukan' ? 'text-success' : 'text-danger' %>">Jumlah Nominal (Rp)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-secondary-subtle fw-bold">Rp</span>
                            <input type="number" name="nominal" class="form-control fw-bold font-monospace <%= jenis === 'pemasukan' ? 'text-success border-success' : 'text-danger border-danger' %>" placeholder="0" min="1" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Keterangan / Deskripsi Transaksi</label>
                        <textarea name="keterangan" class="form-control border-secondary" rows="4" placeholder="Contoh: Terima iuran warga blok C / Pembelian lampu jalan gang 3..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a href="/kas" class="btn btn-light px-4 border">Batal</a>
                        <button type="submit" class="btn btn-lg fw-bold px-5 <%= jenis === 'pemasukan' ? 'btn-success' : 'btn-danger' %>">Simpan ke Sheet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
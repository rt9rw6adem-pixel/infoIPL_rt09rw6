<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Data IPL Warga</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 700px;">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark"><h4 class="mb-0">Form Edit Data Pembayaran IPL</h4></div>
            <div class="card-body">
                <form action="/update/<%= warga.get('no') %>" method="POST">
                    <input type="hidden" name="tahun_target" value="<%= tahunAktif %>">
                    <div class="alert alert-warning py-2 mb-3">Mengedit laporan warga <strong>Tahun <%= tahunAktif %></strong></div>

                    <div class="mb-3">
                        <label class="form-label">Nama Kepala Keluarga (KK)</label>
                        <input type="text" name="nama_kk" class="form-control" value="<%= warga.get('nama_kk') %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Blok Rumah</label>
                        <select name="blok_rumah" class="form-select" required>
                            <% daftarBlok.forEach(blok => { %>
                                <option value="<%= blok %>" <%= warga.get('blok_rumah') === blok ? 'selected' : '' %>><%= blok %></option>
                            <% }) %>
                        </select>
                    </div>
                    
                    <h5 class="mt-4 text-secondary">Status Pembayaran Iuran (Rp)</h5><hr>
                    <div class="row">
                        <% ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"].forEach(bln => { %>
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><%= bln %></label>
                                <input type="text" name="<%= bln.toLowerCase() %>" class="form-control" value="<%= warga.get(bln) || '' %>">
                            </div>
                        <% }) %>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Iuran THR</label>
                        <input type="text" name="thr" class="form-control" value="<%= warga.get('THR') || '' %>">
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <a href="/?tahun=<%= tahunAktif %>" class="btn btn-secondary">Batal</a>
                        <button type="submit" class="btn btn-warning fw-bold">Update Data</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
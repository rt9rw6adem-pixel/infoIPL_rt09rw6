<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistem IPL Warga</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-secondary d-flex align-items-center" style="height: 100vh;">
    <div class="container" style="max-width: 400px;">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 fw-bold">SISTEM IPL WARGA</h4>
                <small class="text-muted">Silakan Login Terlebih Dahulu</small>
            </div>
            <div class="card-body p-4">
                <% if (pesanError) { %>
                    <div class="alert alert-danger py-2 text-center" style="font-size: 14px;"><%= pesanError %></div>
                <% } %>
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" name="username" class="form-control" placeholder="Masukkan username" required autocomplete="off">
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Masukkan password" required>
                    </div>
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Masuk ke Sistem</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>